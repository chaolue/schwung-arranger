{
  "title": "Arranger",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Build songs from a",
        "MIDI drum library.",
        "",
        "3 modes:",
        " Song Builder",
        " Setlists/Perform",
        " Jam",
        "",
        "Hold Back anywhere",
        "to suspend (keeps",
        "playing).",
        "",
        "Hold Track 1-4 to",
        "edit a Schwung",
        "chain alongside.",
        "",
        "Tap Back twice to",
        "exit."
      ]
    },
    {
      "title": "Song Builder",
      "children": [
        {
          "title": "Tracks",
          "lines": [
            "Track 1: Drum, or",
            "Chord (press again).",
            "Track 2: Inst 1",
            "Track 3: Inst 2",
            "Track 4: Click;",
            "again: click on/off.",
            "",
            "Every track lists",
            "the section's items:",
            "clips, chords, inst",
            "changes or click",
            "volumes. Jog, click,",
            "Shift+Jog, Delete",
            "and Copy act on the",
            "selected one."
          ]
        },
        {
          "title": "Editing Clips",
          "lines": [
            "Jog: move cursor",
            "Click: open Trim",
            "Shift+Jog: move clip",
            "Tap pad: insert",
            "Hold pad: preview",
            "Delete: remove clip",
            "Copy: duplicate",
            "Left/Right: section",
            "Menu: song settings",
            "",
            "Mute: merge with the",
            "next section.",
            "Shift+Mute: split",
            "at the cursor clip.",
            "(Stopped only.)"
          ]
        },
        {
          "title": "Chords",
          "lines": [
            "Track 1 again shows",
            "the Chord track: the",
            "section's chords,",
            "each from a bar and",
            "beat (b3.2) until",
            "the next one.",
            "",
            "Click a chord: Root,",
            "Type, Bass, Bar,",
            "Beat, Advanced",
            "(half beats).",
            "",
            "+ Add: a chord after",
            "the last one.",
            "Shift+Jog: move it.",
            "",
            "Root No Chord: a",
            "silent bar until the",
            "next chord."
          ]
        },
        {
          "title": "Instruments",
          "lines": [
            "Menu: Instrument",
            "Settings (defaults).",
            "",
            "Chord or Bass voice.",
            "Octave shift.",
            "Follow Note: fires",
            "on a drum hit.",
            "Note Gap: cuts note",
            "before the next.",
            "",
            "Items change them",
            "from a bar/beat:",
            "Mute, Octave,",
            "Follow, Voicing...",
            "Each section starts",
            "on the defaults."
          ]
        },
        {
          "title": "Click Track",
          "lines": [
            "Track 4 shows it.",
            "Items set the click",
            "volume from a bar/",
            "beat; 0% = silent.",
            "",
            "Each section starts",
            "at Options > Click",
            "> Volume."
          ]
        },
        {
          "title": "Song Settings",
          "lines": [
            "Menu: open Song",
            "Settings.",
            "",
            "Name, Tempo, Time",
            "Signature, Key and",
            "Lock Song.",
            "",
            "Restore Backup:",
            "pick a saved version",
            "(newest first, with",
            "its section count).",
            "",
            "The version replaced",
            "is kept as a backup,",
            "so a restore can be",
            "undone. The last 10",
            "versions are kept.",
            "",
            "Not available while",
            "the song is locked."
          ]
        }
      ]
    },
    {
      "title": "Setlists/Perform",
      "lines": [
        "Build a setlist of",
        "songs.",
        "",
        "Each song can have",
        "a count-in click.",
        "",
        "In Perform, tap a",
        "pad to queue a song",
        "or section, then",
        "press Play.",
        "",
        "Track 1/2/3: turn",
        "Drums/Inst 1/Inst 2",
        "on or off.",
        "",
        "Record: record the",
        "Schwung mix to a",
        "WAV (Recordings/",
        "Arranger)."
      ]
    },
    {
      "title": "Perform Knobs",
      "lines": [
        "Map knobs in Setlist",
        "Edit > (knobs).",
        "",
        "A song can override",
        "a knob, or turn it",
        "Off: Song Settings >",
        "Knobs.",
        "",
        "Each knob controls a",
        "Schwung chain or",
        "Master FX param.",
        "Values are restored",
        "per song; a turn in",
        "Perform saves it for",
        "the current song.",
        "",
        "Touch: show chain,",
        "module and value.",
        "",
        "Warns if the loaded",
        "Move Set is not the",
        "setlist's.",
        "",
        "My Presets: steps",
        "through a module's",
        "user presets.",
        "",
        "Shift+Jog on the",
        "Knobs screen: move",
        "a knob's mapping.",
        "",
        "Sample: 4 banks of",
        "8 knobs (Sample lit",
        "in the bank colour;",
        "knob lights show",
        "each value)."
      ]
    },
    {
      "title": "Jam Mode",
      "children": [
        {
          "title": "Grooves & Fills",
          "lines": [
            "Left pads: grooves.",
            "Right pads: fills.",
            "",
            "Tap a fill to queue",
            "it for the next",
            "bar end.",
            "",
            "Jog wheel changes",
            "BPM live."
          ]
        },
        {
          "title": "Chord Pads",
          "lines": [
            "Track 2/3: turn",
            "Inst 1/2 on or off.",
            "",
            "When on, the 2 left",
            "columns are chords",
            "of the key.",
            "",
            "Shift+Jog: key.",
            "",
            "Playing: red = next",
            "bar, white = now.",
            "Stopped: green =",
            "plays on Play; tap",
            "again to clear.",
            "",
            "Hold a chord pad",
            "to see its name."
          ]
        },
        {
          "title": "Instruments",
          "lines": [
            "Shift+Track 2/3",
            "opens Inst 1/2",
            "settings (live).",
            "",
            "Follow Note: drum",
            "note that plays",
            "the chord. Off =",
            "once per bar.",
            "",
            "Track 1: drums",
            "on/off."
          ]
        }
      ]
    },
    {
      "title": "Schwung Chains",
      "lines": [
        "Hold Track 1-4:",
        "edit Schwung chain",
        "1-4 while the song",
        "keeps playing.",
        "Then tap a Track:",
        "its chain; tap it",
        "again for chain 5-8",
        "(Track 1: 1 <-> 5).",
        "(Needs 8 slots.)",
        "Hold Menu: Master FX",
        "(tap a Track there:",
        "its chain).",
        "",
        "Pads, steps and Play",
        "stay the Arranger's.",
        "",
        "Back: steps out of",
        "the editor.",
        "Menu: back to the",
        "Arranger.",
        "",
        "A Track or Menu tap",
        "acts on release."
      ]
    },
    {
      "title": "Options",
      "lines": [
        "Drums, Inst 1, and",
        "Inst 2 each set",
        "output + channel",
        "on their own.",
        "",
        "Swap Guard trims",
        "notes at clip",
        "boundaries.",
        "",
        "Chains: set a",
        "Schwung chain's MIDI",
        "channel; Edit Chain",
        "opens it.",
        "",
        "Schwung Clock: sends",
        "the song tempo to",
        "Schwung, so synced",
        "LFOs and delays",
        "keep time.",
        "",
        "Click: metronome",
        "output, channel,",
        "accent/normal notes",
        "and Volume."
      ]
    }
  ]
}

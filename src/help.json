{
  "title": "Arranger",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Build songs from a",
        "MIDI drum library.",
        "",
        "3 modes:",
        " Song Builder",
        " Setlists/Perform",
        " Jam",
        "",
        "Hold Back anywhere",
        "to suspend (keeps",
        "playing).",
        "",
        "Tap Back to exit."
      ]
    },
    {
      "title": "Song Builder",
      "children": [
        {
          "title": "Tracks",
          "lines": [
            "Track 1: Drum",
            "Track 2: Chord",
            "Track 3: Inst 1",
            "Track 4: Inst 2",
            "",
            "Press to switch.",
            "Only Drum has full",
            "clip editing."
          ]
        },
        {
          "title": "Editing Clips",
          "lines": [
            "Jog: move cursor",
            "Click: open Trim",
            "Tap pad: insert",
            "Hold pad: preview",
            "Delete: remove clip",
            "Copy: duplicate",
            "Left/Right: section",
            "Menu: song settings"
          ]
        },
        {
          "title": "Chords",
          "lines": [
            "Step button opens",
            "chord picker for",
            "that bar.",
            "",
            "Set root, type, and",
            "bass note.",
            "",
            "Drives Instrument",
            "tracks set to Chord."
          ]
        },
        {
          "title": "Instruments",
          "lines": [
            "Menu: Instrument",
            "Settings.",
            "",
            "Chord or Bass voice.",
            "Octave shift.",
            "",
            "Follow Note: fires",
            "on a drum hit.",
            "",
            "Note Gap: cuts note",
            "before the next."
          ]
        }
      ]
    },
    {
      "title": "Setlists/Perform",
      "lines": [
        "Build a setlist of",
        "songs.",
        "",
        "Each song can have",
        "a count-in click.",
        "",
        "In Perform, tap a",
        "pad to queue a song",
        "or section, then",
        "press Play.",
        "",
        "Track 1/3/4: turn",
        "Drums/Inst 1/Inst 2",
        "on or off."
      ]
    },
    {
      "title": "Jam Mode",
      "children": [
        {
          "title": "Grooves & Fills",
          "lines": [
            "Left pads: grooves.",
            "Right pads: fills.",
            "",
            "Tap a fill to queue",
            "it for the next",
            "bar end.",
            "",
            "Jog wheel changes",
            "BPM live."
          ]
        },
        {
          "title": "Chord Pads",
          "lines": [
            "Track 3/4: turn",
            "Inst 1/2 on or off.",
            "",
            "When on, the 2 left",
            "columns are chords",
            "of the key.",
            "",
            "Shift+Jog: key.",
            "",
            "Playing: red = next",
            "bar, white = now.",
            "Stopped: green =",
            "plays on Play; tap",
            "again to clear.",
            "",
            "Hold a chord pad",
            "to see its name."
          ]
        },
        {
          "title": "Instruments",
          "lines": [
            "Shift+Track 3/4",
            "opens Inst 1/2",
            "settings (live).",
            "",
            "Follow Note: drum",
            "note that plays",
            "the chord. Off =",
            "once per bar.",
            "",
            "Track 1: drums",
            "on/off."
          ]
        }
      ]
    },
    {
      "title": "Options",
      "lines": [
        "Drums, Inst 1, and",
        "Inst 2 each set",
        "output + channel",
        "on their own.",
        "",
        "Swap Guard trims",
        "notes at clip",
        "boundaries."
      ]
    }
  ]
}
